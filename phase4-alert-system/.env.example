# copy to .env (never commit .env) and export before running, for example: set -a; source .env; set +a
HT_ENV=development
HT_DATABASE_URL=sqlite:///./healthtrack.db
# HT_DATABASE_URL=postgresql+psycopg://healthtrack@localhost:5432/healthtrack
# required in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HT_JWT_SECRET=
HT_ACCESS_TOKEN_MINUTES=15
HT_BCRYPT_ROUNDS=12
HT_LOGIN_RATE_LIMIT=10
HT_LOG_LEVEL=INFO
HT_CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050
# phase 4 alerting
HT_ALERT_WORKERS=1
HT_ESCALATION_CHECK_SECONDS=30
HT_PATTERN_CHECK_MINUTES=15
HT_DIGEST_HOUR=7
HT_PROGRAM_TIMEZONE=America/Denver
HT_ALERT_STORM_CAP=4
HT_DASHBOARD_URL=http://localhost:8050
# without these, email and sms are written to json-lines files in HT_OUTBOX_DIR
HT_OUTBOX_DIR=./outbox
# HT_SMTP_HOST=smtp.example.org
# HT_SMTP_PORT=587
# HT_SMTP_FROM=alerts@healthtrack.example
# HT_SMS_WEBHOOK_URL=https://sms-gateway.example.org/send
# optional: run the test suite against postgres as well
# HT_TEST_DATABASE_URL=postgresql+psycopg://healthtrack@localhost:5432/healthtrack_test
